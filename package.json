{
  "name": "combray",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,server --prefix-colors auto \"pnpm --filter @combray/web dev\" \"pnpm run dev:server\"",
    "dev:server": "node --env-file=deploy/dev.env --env-file=deploy/dev-hot.env --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "serve": "pnpm build && node --env-file=deploy/dev.env --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "build": "pnpm --filter @combray/web build && pnpm --filter @combray/keys build",
    "test": "pnpm run test:client && pnpm run test:server",
    "test:client": "pnpm -r --filter '!@combray/server' test",
    "test:server": "pnpm --filter @combray/server test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm build && pnpm --filter @combray/keys e2e",
    "docker": "docker build -t combray-server:dev .",
    "admin": "node --env-file=deploy/dev.env --disable-warning=ExperimentalWarning apps/server/src/cli.ts",
    "synthetic-donation": "node apps/keys/scripts/run.mjs synthetic-donation"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
