{
  "format": "combray-importer@1",
  "name": {"en": "TikTok", "nl": "TikTok"},
  "names": [
    {"id": "tiktok-likes", "text": "TikTok likes", "label": {"nl": "TikTok-likes"}},
    {"id": "time", "text": "Time", "label": {"nl": "Tijd"}},
    {"id": "video", "text": "Video"},
    {"id": "tiktok-searches", "text": "TikTok searches", "label": {"nl": "TikTok-zoekopdrachten"}},
    {"id": "search", "text": "Search", "label": {"nl": "Zoekopdracht"}},
    {"id": "tiktok-watch-history", "text": "TikTok watch history", "label": {"nl": "TikTok-kijkgeschiedenis"}}
  ],
  "root":
  {"id": "root", "kind": "map", "match": [], "find": ["user_data*.json"], "children": [
    {"id": "Activity", "kind": "map", "match": ["Activity", "Your Activity", "Likes and Favorites"], "children": [
      {"id": "Like List", "kind": "map", "match": ["Like List"], "children": [
        {"id": "ItemFavoriteList", "kind": "list", "match": ["ItemFavoriteList", "itemFavoriteList"], "nameId": "tiktok-likes", "children": [
          {"id": "[*]", "kind": "map", "match": ["[*]"], "children": [
            {"id": "Date", "kind": "value", "match": ["Date", "date"], "nameId": "time", "decision": "show", "as": "datetime", "format": "YYYY-MM-DD HH:mm:ss", "role": "date"},
            {"id": "Link", "kind": "value", "match": ["Link", "link", "VideoLink"], "nameId": "video", "decision": "show", "as": "url", "role": "url"}
          ]}
        ]}
      ]},
      {"id": "Search History", "kind": "map", "match": ["Search History", "Searches"], "children": [
        {"id": "SearchList", "kind": "list", "match": ["SearchList", "searchList"], "nameId": "tiktok-searches", "children": [
          {"id": "[*]", "kind": "map", "match": ["[*]"], "children": [
            {"id": "Date", "kind": "value", "match": ["Date", "date"], "nameId": "time", "decision": "show", "as": "datetime", "format": "YYYY-MM-DD HH:mm:ss", "role": "date"},
            {"id": "SearchTerm", "kind": "value", "match": ["SearchTerm", "searchTerm"], "nameId": "search", "decision": "show", "role": "title"}
          ]}
        ]}
      ]},
      {"id": "Video Browsing History", "kind": "map", "match": ["Video Browsing History", "Watch History"], "children": [
        {"id": "VideoList", "kind": "list", "match": ["VideoList", "videoList"], "nameId": "tiktok-watch-history", "children": [
          {"id": "[*]", "kind": "map", "match": ["[*]"], "children": [
            {"id": "Date", "kind": "value", "match": ["Date", "date"], "nameId": "time", "decision": "show", "as": "datetime", "format": "YYYY-MM-DD HH:mm:ss", "role": "date"},
            {"id": "Link", "kind": "value", "match": ["Link", "link", "VideoLink"], "nameId": "video", "decision": "show", "as": "url", "role": "url"}
          ]}
        ]}
      ]}
    ]}
  ]}
}
