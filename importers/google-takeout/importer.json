{
  "format": "combray-importer@1",
  "name": {"en": "Google Takeout", "nl": "Google Takeout"},
  "entries": [
    {"path": [], "kind": "dir", "find": ["Takeout", "takeout-*.zip"], "newChildren": "skip"},
    {"path": ["Chrome"], "kind": "dir", "newChildren": "ask"},
    {"path": ["YouTube and YouTube Music"], "kind": "dir", "aliases": ["YouTube en YouTube Music", "YouTube und YouTube Music"], "newChildren": "ask"},
    {"path": ["YouTube and YouTube Music", "history"], "kind": "dir", "aliases": ["geschiedenis", "Verlauf"]},
    {"path": ["YouTube and YouTube Music", "subscriptions"], "kind": "dir", "aliases": ["abonnementen", "Abos"]},
    {"path": ["My Activity"], "kind": "dir", "aliases": ["Mijn activiteit", "Meine Aktivitäten"], "newChildren": "ask"},
    {"path": ["My Activity", "Search"], "kind": "dir", "aliases": ["Zoeken", "Suche"]},
    {"path": ["archive_browser.html"], "kind": "element", "decision": "ignore"},
    {"path": ["Chrome", "BrowserHistory.json"], "kind": "map", "aliases": ["History.json"]},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History"], "kind": "list", "label": {"en": "Chrome browsing history", "nl": "Chrome-browsergeschiedenis"}},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]"], "kind": "map", "filter": [{"column": "url", "test": {"matches": "google\\.[a-z.]+/search", "flags": "i"}, "not": true}]},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "title"], "kind": "value", "decision": "show", "label": {"en": "Page", "nl": "Pagina"}, "role": "title"},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "url"], "kind": "value", "decision": "show", "label": {"en": "Link", "nl": "Link"}, "as": "url", "role": "url"},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "time_usec"], "kind": "value", "decision": "show", "label": {"en": "Time", "nl": "Tijd"}, "as": "datetime", "format": "epoch-us", "role": "date"},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "page_transition"], "kind": "value", "decision": "show", "label": {"en": "How you got there", "nl": "Hoe je er kwam"}},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "client_id"], "kind": "value", "decision": "ignore"},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "favicon_url"], "kind": "value", "decision": "ignore"},
    {"path": ["Chrome", "BrowserHistory.json", "Browser History", "[*]", "ptoken"], "kind": "map", "decision": "ignore"},
    {"path": ["My Activity", "Search", "MyActivity.json"], "kind": "list", "aliases": ["MijnActiviteit.json", "MeineAktivitäten.json"], "label": {"en": "Google searches", "nl": "Google-zoekopdrachten"}},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]"], "kind": "map", "filter": [{"column": "titleUrl", "test": {"matches": "google\\.[a-z.]+/search", "flags": "i"}}]},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]", "title"], "kind": "value", "decision": "show", "label": {"en": "Search", "nl": "Zoekopdracht"}, "transform": [{"replace": {"pattern": "^(Searched for|Gezocht naar|Gesucht nach) ", "with": ""}}], "role": "title"},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]", "titleUrl"], "kind": "value", "decision": "show", "label": {"en": "Link", "nl": "Link"}, "as": "url", "role": "url"},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]", "time"], "kind": "value", "decision": "show", "label": {"en": "Time", "nl": "Tijd"}, "as": "datetime", "role": "date"},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]", "header"], "kind": "value", "decision": "ignore"},
    {"path": ["My Activity", "Search", "MyActivity.json", "[*]", "products"], "kind": "list", "decision": "ignore"},
