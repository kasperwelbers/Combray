    {"path": ["YouTube and YouTube Music", "history", "watch-history.json", "[*]", "titleUrl"], "kind": "value", "decision": "show", "label": {"en": "Link", "nl": "Link"}, "as": "url", "role": "url"},
    {"path": ["YouTube and YouTube Music", "history", "watch-history.json", "[*]", "time"], "kind": "value", "decision": "show", "label": {"en": "Time", "nl": "Tijd"}, "as": "datetime", "role": "date"},
