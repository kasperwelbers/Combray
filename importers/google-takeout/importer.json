    {"path": ["YouTube and YouTube Music", "history", "search-history.json", "[*]", "title"], "kind": "value", "decision": "show", "label": {"en": "Search", "nl": "Zoekopdracht"}, "transform": [{"replace": {"pattern": "^(Searched for|Gezocht naar|Gesucht nach) ", "with": ""}}], "role": "title"},
