# Copy to .env next to docker-compose.yml. Never commit .env: it holds the SMTP password.

# The participant app is served at https://$COMBRAY_DOMAIN and the key page at
# https://keys.$COMBRAY_DOMAIN. Both names need DNS records pointing at this server.
COMBRAY_DOMAIN=combray.example.edu
# Only if the key page cannot be keys.$COMBRAY_DOMAIN: its full address, with the Caddyfile's
# keys.{$COMBRAY_DOMAIN} block changed to the same name. Never a name under the key page's.
# COMBRAY_KEYS_URL=https://combray-keys.example.edu

# Mail for researcher sign-in codes. smtps:// for TLS on connect (port 465), or
# smtp://…?tls=required for STARTTLS (port 587).
COMBRAY_SMTP_URL=smtps://combray:change-me@smtp.example.edu:465
COMBRAY_MAIL_FROM=Combray <combray@example.edu>

# How long backups of combray-donation-keys are kept. Participants are told a withdrawal is
# complete within this many days, so set your backup retention to match.
COMBRAY_KEY_BACKUP_RETENTION_DAYS=30
