# With pnpm dev the web client runs on Vite (:5173) with hot reload, so that is the main site's
# address: studio sign-in and the key page's links then land there.
COMBRAY_PUBLIC_URL=http://localhost:5173
# The key page stays on the server itself, not on Vite.
COMBRAY_KEYS_URL=http://keys.localhost:8080
