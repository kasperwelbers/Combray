# Settings for the development server (pnpm dev, pnpm serve, pnpm admin). Synthetic data
# only: the example projects, and every database, the store master key and sign-in mails under
# .dev/ (not committed). Production settings are in docs/deployment.md.
COMBRAY_WEB_DIR=apps/web/dist
COMBRAY_KEYS_PAGE=apps/keys/dist/index.html
COMBRAY_DATA_DIR=deploy/examples
COMBRAY_BIND=127.0.0.1:8080
COMBRAY_DB=.dev/combray.sqlite
COMBRAY_STORE_MASTER_KEY_FILE=.dev/store-master.key
COMBRAY_DONATION_KEYS_DB=.dev/donation-keys.sqlite
# The key page is then on http://keys.localhost:8080 (keys. in front of the main host).
COMBRAY_PUBLIC_URL=http://localhost:8080
COMBRAY_MAIL_OUTBOX=.dev/outbox
# How the operator commands are called here, for their usage text (pnpm admin researcher list).
COMBRAY_CLI_NAME=pnpm admin
